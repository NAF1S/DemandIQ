# Copy to `.env` and fill in the values from your Supabase project.
# Supabase dashboard -> Project Settings -> API / Database.

APP_NAME="DemandIQ API"
ENVIRONMENT=development
DEBUG=false

# --- Supabase REST (Storage + Auth) -----------------------------------------
# Project URL, e.g. https://abcdefghijklm.supabase.co
SUPABASE_URL=
# Dashboard -> Project Settings -> API keys
SUPABASE_ANON_KEY=
# Server-side key. Required for Storage writes and admin Auth calls.
# Never expose this to a client.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_MODEL_BUCKET=model-artifacts

# --- Supabase Postgres (direct connection, used for data queries) -----------
# Dashboard -> Connect -> "Transaction pooler" (port 6543) or "Direct connection".
# The app rewrites postgres:// -> postgresql+asyncpg:// and handles sslmode/pgbouncer.
DATABASE_URL=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=false

# --- Predictions -----------------------------------------------------------
# Registers a deterministic placeholder predictor so the endpoints are testable
# before your real model is wired in. Set to false in production.
ENABLE_DEMO_PREDICTOR=true

# Comma-separated list of allowed CORS origins.
CORS_ORIGINS=*
