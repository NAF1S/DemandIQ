# Copy to `.env` and fill in the values from your Supabase project.
# Supabase dashboard -> Project Settings -> API / Database.

APP_NAME=DemandIQ API
ENVIRONMENT=development
DEBUG=false

# --- Supabase REST (Storage + Auth) -----------------------------------------
# Project URL, e.g. https://abcdefghijklm.supabase.co
SUPABASE_URL=
# Dashboard -> Project Settings -> API keys
SUPABASE_ANON_KEY=
# Server-side key. Required for Storage writes and admin Auth calls.
# Never expose this to a client.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_MODEL_BUCKET=model-artifacts

# --- Supabase Postgres (direct connection, used for data queries) -----------
# Dashboard -> Connect. Two things to know:
#
# 1. `db.<ref>.supabase.co` publishes an IPv6 (AAAA) record only. On a network without
#    IPv6 use the IPv4-compatible Supavisor pooler instead:
#        aws-0-<region>.pooler.supabase.com   user=postgres.<ref>
#    Port 5432 = session mode (best for a long-lived server).
#    Port 6543 = transaction mode (serverless; the app disables asyncpg's statement
#                cache automatically when it sees port 6543).
# 2. `sslmode=require` encrypts without validating the certificate, matching libpq.
#    Use `verify-full` to also validate the certificate chain and hostname.
DATABASE_URL=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=false

# Comma-separated list of allowed CORS origins.
CORS_ORIGINS=*
